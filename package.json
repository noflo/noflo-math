    "type": "git",
    "url": "git+ssh://git@github.com/noflo/noflo-math.git"
  },
  "license": "MIT",
  "dependencies": {
    "@noflo/noflo": "^2.0.0-alpha.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true components/ test/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write components/ test/",
    "types": "tsc -p tsconfig.json",
    "test": "npm run types && npm run lint && npm run test:node",
    "test:node": "node --test test/*.test.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
